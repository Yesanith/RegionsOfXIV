<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Matches the plugin's target framework and platform, because it references the
    plugin project and a net10.0 test assembly cannot load a net10.0-windows one.

    Nothing here pulls in Dalamud. The types under test — NotificationGate,
    LocationSnapshot, Configuration's migration — were deliberately kept clear of
    it, so the test host never has to resolve an assembly that only exists inside
    a XIVLauncher install. That is the whole reason IGameState and IGateSettings
    exist; if a test ever fails with a Dalamud assembly load error, the seam has
    sprung a leak rather than the test being wrong.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RegionsOfXIV\RegionsOfXIV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
