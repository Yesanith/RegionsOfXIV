<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <PackageProjectUrl>https://github.com/yayurekseckin/RegionsOfXIV</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Bundled assets. The game's own fonts (AXIS / Jupiter / TrumpGothic / Meidinger)
    do NOT go here - Dalamud loads those straight out of the game's files at
    runtime. Only fonts we ship ourselves (e.g. the Eorzean alphabet) belong in
    assets/fonts.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\fonts\**\*.ttf;..\..\assets\fonts\**\*.otf">
      <Link>Fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
