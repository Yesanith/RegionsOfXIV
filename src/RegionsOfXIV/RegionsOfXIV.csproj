<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.6.0.0</Version>
    <PackageProjectUrl>https://github.com/Yesanith/RegionsOfXIV</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RegionsOfXIV.Tests" />
  </ItemGroup>

  <!-- Playing a sound file. Core carries the readers and the sample providers, WinMM the
       WaveOutEvent device and the ACM decoder that Mp3FileReader needs. Wasapi is deliberately
       not here: it would bring a second output path and a second MP3 decoder for nothing. -->
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Services\SheetSearch.cs" />
    <Compile Remove="UI\IconBrowserWindow.cs" />
    <Compile Remove="UI\BannerPreviewWindow.cs" />
  </ItemGroup>

  <!-- One file per language, picked up by the glob and discovered at runtime from the resource
       names, so a new language needs no code change. en.json is excluded on purpose: English is
       the fallback compiled into the call sites, and that file is only the translators' copy. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" Exclude="Localization\en.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\fonts\**\*.ttf;..\..\assets\fonts\**\*.otf">
      <Link>Fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>

    <Content Include="..\..\assets\images\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
